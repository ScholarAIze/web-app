<section id="contact" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="section-title anime-fade-up" data-anime-delay="0">Get In Touch</h2>
      <p class="section-subtitle anime-fade-up mb-12" data-anime-delay="100">
        Interested in collaborating or using our tools for your research? We'd love to hear from you.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 anime-stagger" data-anime-delay="200">
        <a href="mailto:amintg@mun.ca" class="card text-center group">
          <div class="text-4xl mb-4">📧</div>
          <h3 class="text-lg font-semibold mb-2 text-slate-900">Email</h3>
          <p class="text-primary group-hover:text-primary-light transition-colors">amintg@mun.ca</p>
        </a>

        <a href="https://github.com/amintaheri23" target="_blank" rel="noopener noreferrer" class="card text-center group">
          <div class="text-4xl mb-4">💻</div>
          <h3 class="text-lg font-semibold mb-2 text-slate-900">GitHub</h3>
          <p class="text-primary group-hover:text-primary-light transition-colors">@aminTaheri23</p>
        </a>
      </div>

      <div class="mt-12 anime-fade-up" data-anime-delay="400">
        <a
          href="https://aminTaheri23.github.io"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-slate-600 hover:text-primary transition-colors"
