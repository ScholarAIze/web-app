---
<section class="min-h-screen flex items-center justify-center bg-gradient-to-br from-slate-50 to-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="text-center">
      <div class="anime-fade-up" data-anime-delay="0">
        <h1 class="text-4xl md:text-6xl font-bold text-slate-900 mb-6 text-balance">
          Bringing AI-Powered Research Tools to Scholars
        </h1>
        <p class="text-xl md:text-2xl text-slate-600 mb-8 max-w-3xl mx-auto text-balance">
          We develop innovative AI applications that transform complex research into accessible, user-friendly tools.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/projects" class="btn-primary">
            Explore Our Projects
          </a>
          <a href="#contact" class="btn-secondary">
            Get In Touch
          </a>
        </div>
      </div>

      <div class="mt-16 anime-fade-up" data-anime-delay="200">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="card text-center">
            <div class="text-4xl mb-4">🎓</div>
            <h3 class="text-xl font-semibold mb-2 text-slate-900">For Scholars</h3>
            <p class="text-slate-600">AI tools designed specifically for academic research needs</p>
          </div>
          <div class="card text-center">
            <div class="text-4xl mb-4">💻</div>
            <h3 class="text-xl font-semibold mb-2 text-slate-900">User-Friendly</h3>
            <p class="text-slate-600">Intuitive interfaces that require no technical expertise</p>
          </div>
          <div class="card text-center">
            <div class="text-4xl mb-4">🔒</div>
            <h3 class="text-xl font-semibold mb-2 text-slate-900">Offline Processing</h3>
            <p class="text-slate-600">Client-side computation for data privacy and accessibility</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
