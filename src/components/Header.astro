---
import ThemeToggle from './ThemeToggle.astro';

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/blog', label: 'Blog' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/80 dark:bg-dark-bg/80 backdrop-blur-md border-b border-slate-200 dark:border-slate-700">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="text-xl font-bold text-primary dark:text-white">
        Scholaraize
      </a>

      <div class="hidden md:flex items-center space-x-8">
        {navItems.map(item => (
          <a
            href={item.href}
            class="text-slate-600 dark:text-slate-300 hover:text-primary dark:hover:text-secondary transition-colors font-medium"
          >
            {item.label}
          </a>
        ))}
      </div>

      <div class="flex items-center space-x-4">
        <ThemeToggle />
      </div>
    </div>
  </nav>
</header>
