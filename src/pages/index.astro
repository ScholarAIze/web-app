---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnimatedHero from '../components/AnimatedHero.jsx';
import AnimatedServices from '../components/AnimatedServices.jsx';
import AnimatedProjects from '../components/AnimatedProjects.jsx';
import AnimatedContact from '../components/AnimatedContact.jsx';

const title = "Scholaraize - AI Applications for Scholars | Innovation in Research Tools";
const description = "We develop innovative AI applications for scholars. User-friendly tools with offline processing. Transform your research into accessible solutions.";
---

<BaseLayout title={title} description={description}>
  <AnimatedHero client:load />
  <AnimatedServices client:visible />
  <AnimatedProjects client:visible />
  <AnimatedContact client:visible />
</BaseLayout>
