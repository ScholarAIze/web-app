---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const { title, description, image, type, noindex } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <SEO {title} {description} {image} {type} {noindex} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/animejs@3.2.2/lib/anime.min.js"></script>
    <style>
      html {
        font-family: 'Inter', system-ui, sans-serif;
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-grow pt-16">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const el = entry.target;
            const delay = parseInt(el.dataset.animeDelay || '0');
            const duration = parseInt(el.dataset.animeDuration || '800');
            const easing = el.dataset.animeEasing || 'easeOutExpo';

            if (el.classList.contains('anime-fade-up')) {
              anime({
                targets: el,
                opacity: [0, 1],
                translateY: [40, 0],
                duration: duration,
                delay: delay,
                easing: easing
              });
            } else if (el.classList.contains('anime-fade-in')) {
              anime({
                targets: el,
                opacity: [0, 1],
                duration: duration,
                delay: delay,
                easing: easing
              });
            } else if (el.classList.contains('anime-scale')) {
              anime({
                targets: el,
                opacity: [0, 1],
                scale: [0.9, 1],
                duration: duration,
                delay: delay,
                easing: easing
              });
            } else if (el.classList.contains('anime-stagger')) {
              anime({
                targets: el.children,
                opacity: [0, 1],
                translateY: [30, 0],
                duration: duration,
                delay: anime.stagger(100, { start: delay }),
                easing: easing
              });
            }

            observer.unobserve(el);
          }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

      document.querySelectorAll('.anime-fade-up, .anime-fade-in, .anime-scale, .anime-stagger').forEach(el => {
        observer.observe(el);
      });
    </script>

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XXXXXXXXXX');
    </script>
  </body>
</html>
