---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const { title, description, image, type, noindex } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <SEO {title} {description} {image} {type} {noindex} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <script is:inline>
      window.addEventListener('DOMContentLoaded', function() {
        var script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/animejs@3.2.2/lib/anime.min.js';
        script.onload = function() {
          initAnimations();
        };
        script.onerror = function() {
          console.warn('anime.js failed to load, showing content without animations');
          document.querySelectorAll('.anime-fade-up, .anime-fade-in, .anime-scale').forEach(function(el) {
            el.style.opacity = '1';
            el.style.transform = 'none';
          });
          document.querySelectorAll('.anime-stagger').forEach(function(el) {
            Array.from(el.children).forEach(function(child) {
              child.style.opacity = '1';
              child.style.transform = 'none';
            });
          });
        };
        document.head.appendChild(script);
      });
    </script>
    <style>
      html {
        font-family: 'Inter', system-ui, sans-serif;
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col bg-white text-slate-900">
    <Header />
    <main class="flex-grow pt-16">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      function initAnimations() {
        if (typeof anime === 'undefined') {
          return;
        }

        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              var el = entry.target;
              var delay = parseInt(el.dataset.animeDelay || '0');
              var duration = parseInt(el.dataset.animeDuration || '800');
              var easing = el.dataset.animeEasing || 'easeOutExpo';

              if (el.classList.contains('anime-fade-up')) {
                anime({
                  targets: el,
                  opacity: [0, 1],
                  translateY: [40, 0],
                  duration: duration,
                  delay: delay,
                  easing: easing
                });
              } else if (el.classList.contains('anime-fade-in')) {
                anime({
                  targets: el,
                  opacity: [0, 1],
                  duration: duration,
                  delay: delay,
                  easing: easing
                });
              } else if (el.classList.contains('anime-scale')) {
                anime({
                  targets: el,
                  opacity: [0, 1],
                  scale: [0.9, 1],
                  duration: duration,
                  delay: delay,
                  easing: easing
                });
              } else if (el.classList.contains('anime-stagger')) {
                anime({
                  targets: el.children,
                  opacity: [0, 1],
                  translateY: [30, 0],
                  duration: duration,
                  delay: anime.stagger(100, { start: delay }),
                  easing: easing
                });
              }

              observer.unobserve(el);
            }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

        document.querySelectorAll('.anime-fade-up, .anime-fade-in, .anime-scale, .anime-stagger').forEach(function(el) {
          observer.observe(el);
        });
      }
    </script>

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XXXXXXXXXX');
    </script>
  </body>
</html>
